# Base PostgreSQL (Neon). Utilisez la chaîne « pooled » fournie par Neon, avec sslmode=require.
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Paiements SasPay (clé secrète côté serveur uniquement : sk_test_... pour les essais, sk_live_... en production).
SASPAY_SECRET_KEY=

# Adresse publique du site (HTTPS en production), utilisée pour le retour SasPay et les liens des emails.
MARYX_PUBLIC_URL=http://localhost:3000

# Fuseau horaire de la tontine (jour calendaire des cotisations). Défaut : Africa/Porto-Novo (UTC+1).
MARYX_TIMEZONE=Africa/Porto-Novo

# Emails via EmailJS (https://dashboard.emailjs.com). Sans ces 4 valeurs, aucun email n’est envoyé.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
